<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
        id="portal_timesheet_breadcrumbs"
        name="Portal breadcrumbs: time entry"
        inherit_id="portal.portal_breadcrumbs"
        priority="40"
    >
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li
                t-if="page_name == 'timesheet_entry' and line_or_new"
                class="breadcrumb-item"
            >
                <a href="/my/timesheet-entries">Time Entry</a>
            </li>
            <li
                t-if="page_name == 'timesheet_entry' and not line_or_new"
                class="breadcrumb-item active"
            >
                Time Entry
            </li>
            <li
                t-if="page_name == 'timesheet_entry' and line_or_new"
                class="breadcrumb-item active"
            >
                <t t-if="line">Edit</t>
                <t t-else="">New</t>
            </li>
        </xpath>
    </template>

    <template
        id="portal_timesheet_menu"
        name="Portal home: time entry"
        inherit_id="portal.portal_my_home"
        priority="50"
    >
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t
                t-if="request.env.user.portal_timesheet_enabled"
                t-call="portal.portal_docs_entry"
            >
                <t t-set="icon" t-value="'/hr_timesheet/static/img/timesheet.svg'" />
                <t t-set="title">Time Entry</t>
                <t t-set="text">Log your hours on the tasks you work on</t>
                <t t-set="url" t-value="'/my/timesheet-entries'" />
                <t t-set="config_card" t-value="True" />
            </t>
        </xpath>
    </template>

    <template id="portal_timesheet_entries" name="Portal: time entries">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True" />
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Time Entry</t>
            </t>
            <div t-if="message == 'saved'" class="alert alert-success" role="status">
                The entry has been saved.
            </div>
            <div t-if="message == 'deleted'" class="alert alert-success" role="status">
                The entry has been deleted.
            </div>
            <div t-if="message == 'locked'" class="alert alert-warning" role="status">
                This entry is invoiced and cannot be deleted.
            </div>
            <div class="mb-3">
                <a href="/my/timesheet-entries/new" class="btn btn-primary">
                    <i class="fa fa-plus" /> Log Time
                </a>
            </div>
            <t t-if="not lines">
                <p class="alert alert-info">You have not logged any time yet.</p>
            </t>
            <t t-else="" t-call="portal.portal_table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Project</th>
                        <th>Task</th>
                        <th class="text-end">Hours</th>
                        <th>Description</th>
                        <th />
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="lines" t-as="entry">
                        <td><span t-field="entry.date" /></td>
                        <td><span t-field="entry.project_id.name" /></td>
                        <td><span t-field="entry.task_id.name" /></td>
                        <td class="text-end">
                            <span
                                t-field="entry.unit_amount"
                                t-options="{'widget': 'float_time'}"
                            />
                        </td>
                        <td><span t-field="entry.name" /></td>
                        <td class="text-end text-nowrap">
                            <t t-if="not entry._portal_timesheet_locked()">
                                <a
                                    t-attf-href="/my/timesheet-entries/#{entry.id}/edit"
                                    class="btn btn-sm btn-secondary"
                                >
                                    <i class="fa fa-pencil" /> Edit
                                </a>
                                <form
                                    t-attf-action="/my/timesheet-entries/#{entry.id}/delete"
                                    method="post"
                                    class="d-inline o_portal_timesheet_delete"
                                >
                                    <input
                                        type="hidden"
                                        name="csrf_token"
                                        t-att-value="request.csrf_token()"
                                    />
                                    <t t-set="confirm_text">Delete this entry?</t>
                                    <button
                                        type="submit"
                                        class="btn btn-sm btn-danger"
                                        onclick="return confirm(this.dataset.confirm);"
                                        t-att-data-confirm="confirm_text"
                                    >
                                        <i class="fa fa-trash" /> Delete
                                    </button>
                                </form>
                            </t>
                            <span t-else="" class="badge text-bg-light">Invoiced</span>
                        </td>
                    </tr>
                </tbody>
            </t>
        </t>
    </template>

    <template id="portal_timesheet_entry_form" name="Portal: time entry form">
        <t t-call="portal.portal_layout">
            <t t-set="line_or_new" t-value="True" />
            <t t-set="breadcrumbs_searchbar" t-value="True" />
            <t t-call="portal.portal_searchbar">
                <t t-set="title">
                    <t t-if="line">Edit Time Entry</t>
                    <t t-else="">Log Time</t>
                </t>
            </t>
            <div t-if="error" class="alert alert-danger" role="alert">
                <t t-out="error" />
            </div>
            <div t-if="not tasks" class="alert alert-info" role="status">
                There are no tasks on which you can log time. Ask your contact to add
                you as a follower of a task.
            </div>
            <form
                t-else=""
                method="post"
                t-att-action="'/my/timesheet-entries/%s/edit' % line.id if line else '/my/timesheet-entries/new'"
                class="mt-3"
            >
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" />
                <div class="mb-3">
                    <label for="task_id" class="form-label">Task</label>
                    <select name="task_id" id="task_id" class="form-select" required="required">
                        <option value="">Select a task</option>
                        <option
                            t-foreach="tasks"
                            t-as="task"
                            t-att-value="task.id"
                            t-att-selected="str(task.id) == form.get('task_id')"
                        >
                            <t t-out="task.project_id.name" /> / <t t-out="task.name" />
                        </option>
                    </select>
                </div>
                <div class="mb-3">
                    <label for="date" class="form-label">Date</label>
                    <input
                        type="date"
                        name="date"
                        id="date"
                        class="form-control"
                        required="required"
                        t-att-value="form.get('date') or today"
                    />
                </div>
                <div class="mb-3">
                    <label for="unit_amount" class="form-label">Hours</label>
                    <input
                        type="number"
                        name="unit_amount"
                        id="unit_amount"
                        class="form-control"
                        step="0.25"
                        min="0.25"
                        max="24"
                        required="required"
                        t-att-value="form.get('unit_amount')"
                    />
                    <div class="form-text">For example 1.5 for one hour and a half.</div>
                </div>
                <div class="mb-3">
                    <label for="name" class="form-label">Description</label>
                    <textarea name="name" id="name" class="form-control" rows="3"><t t-out="form.get('name') or ''" /></textarea>
                </div>
                <button type="submit" class="btn btn-primary">Save</button>
                <a href="/my/timesheet-entries" class="btn btn-secondary">Cancel</a>
            </form>
        </t>
    </template>
</odoo>
