<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_users_form_portal_timesheet" model="ir.ui.view">
        <field name="name">res.users.form.portal.timesheet</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='share']" position="after">
                <field name="portal_timesheet_enabled" invisible="not share" />
            </xpath>
        </field>
    </record>
</odoo>
