<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form_ios" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.ios</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <block id="invoicing_settings" position="after">
                <block title="Statements of Open Items" name="ios_settings">
                    <setting
                        id="ios_reply_days_setting"
                        string="Reply deadline"
                        help="Days the partner has to return a confirmed statement. Can be changed on each statement before printing."
                    >
                        <field name="ios_reply_days" class="oe_inline" /> days
                    </setting>
                </block>
            </block>
        </field>
    </record>
</odoo>
