<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="account_ios_company_rule" model="ir.rule">
        <field name="name">Statement of Open Items: multi-company</field>
        <field name="model_id" ref="model_account_ios" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="account_ios_line_company_rule" model="ir.rule">
        <field name="name">Statement of Open Items Line: multi-company</field>
        <field name="model_id" ref="model_account_ios_line" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
