<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_account_ios" model="report.paperformat">
        <field name="name">Statement of Open Items</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">32</field>
        <field name="margin_bottom">16</field>
        <field name="margin_left">16</field>
        <field name="margin_right">16</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">24</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_account_ios" model="ir.actions.report">
        <field name="name">Statement of Open Items</field>
        <field name="model">account.ios</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">account_ios_hr.report_account_ios</field>
        <field name="report_file">account_ios_hr.report_account_ios</field>
        <field name="print_report_name">'IOS_%s_%s' % (object.partner_id.name, object.date)</field>
        <field name="paperformat_id" ref="paperformat_account_ios"/>
        <field name="binding_model_id" ref="model_account_ios"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
