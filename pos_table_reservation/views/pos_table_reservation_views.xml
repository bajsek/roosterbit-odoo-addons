<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_pos_table_reservation_list" model="ir.ui.view">
        <field name="name">pos.table.reservation.list</field>
        <field name="model">pos.table.reservation</field>
        <field name="arch" type="xml">
            <list>
                <field name="start_datetime" />
                <field name="config_id" />
                <field name="table_id" />
                <field name="guest_name" />
                <field name="guest_phone" />
                <field name="guest_count" />
                <field
                    name="state"
                    widget="badge"
                    decoration-info="state == 'booked'"
                    decoration-success="state == 'seated'"
                    decoration-muted="state == 'cancelled'"
                />
                <field
                    name="company_id"
                    groups="base.group_multi_company"
                    optional="hide"
                />
            </list>
        </field>
    </record>

    <record id="view_pos_table_reservation_form" model="ir.ui.view">
        <field name="name">pos.table.reservation.form</field>
        <field name="model">pos.table.reservation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_seat"
                        type="object"
                        string="Seated"
                        class="btn-primary"
                        invisible="state != 'booked'"
                    />
                    <button
                        name="action_cancel"
                        type="object"
                        string="Cancel"
                        invisible="state != 'booked'"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="booked,seated,cancelled"
                    />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="config_id" readonly="state != 'booked'" />
                            <field
                                name="table_id"
                                readonly="state != 'booked'"
                                domain="[('floor_id.pos_config_ids', '=', config_id)]"
                            />
                            <field name="start_datetime" readonly="state != 'booked'" />
                            <field name="company_id" groups="base.group_multi_company" />
                        </group>
                        <group>
                            <field name="guest_name" readonly="state != 'booked'" />
                            <field name="guest_phone" readonly="state != 'booked'" />
                            <field name="guest_count" readonly="state != 'booked'" />
                            <field name="note" readonly="state != 'booked'" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_pos_table_reservation_search" model="ir.ui.view">
        <field name="name">pos.table.reservation.search</field>
        <field name="model">pos.table.reservation</field>
        <field name="arch" type="xml">
            <search>
                <field name="guest_name" />
                <field name="guest_phone" />
                <field name="table_id" />
                <field name="config_id" />
                <filter name="booked" string="Booked" domain="[('state', '=', 'booked')]" />
                <filter
                    name="today"
                    string="Today"
                    domain="[('start_datetime', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')), ('start_datetime', '&lt;', (context_today() + relativedelta(days=1)).strftime('%Y-%m-%d 00:00:00'))]"
                />
                <group expand="0" string="Group By">
                    <filter
                        name="group_config"
                        string="Point of Sale"
                        context="{'group_by': 'config_id'}"
                    />
                    <filter
                        name="group_day"
                        string="Day"
                        context="{'group_by': 'start_datetime:day'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_pos_table_reservation" model="ir.actions.act_window">
        <field name="name">Table Reservations</field>
        <field name="res_model">pos.table.reservation</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_booked': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Book a table</p>
            <p>
                Today's bookings are shown on the floor plan of the point of sale,
                under the table number.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_pos_table_reservation"
        name="Table Reservations"
        parent="point_of_sale.menu_point_root"
        action="action_pos_table_reservation"
        sequence="45"
        groups="point_of_sale.group_pos_user"
    />
</odoo>
